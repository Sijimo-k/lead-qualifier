# Copy to .env for real use. Leave a line out to keep demo mode for that service.
ANTHROPIC_BASE_URL=https://api.anthropic.com
HUBSPOT_BASE_URL=https://api.hubapi.com
# Your HubSpot account ID (used for "Open in HubSpot" links)
HUBSPOT_PORTAL_ID=12345678
# Slack > Apps > Incoming Webhooks > Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Days without a reply before a follow-up draft is created
FOLLOWUP_AFTER_DAYS=2
TIMEZONE=UTC
# Public URL of your n8n (for webhooks)
WEBHOOK_URL=http://localhost:5678/
